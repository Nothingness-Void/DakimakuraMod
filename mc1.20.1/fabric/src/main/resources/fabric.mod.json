{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_authors}"
  ],
  "contact": {
    "homepage": "${display_url}",
    "issues": "${issue_tracker_url}"
  },
  "license": "${mod_license}",
  "icon": "logo.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.github.andrew0030.dakimakuramod.DakimakuraModFabric"
    ],
    "client": [
      "com.github.andrew0030.dakimakuramod.DakimakuraModClientFabric"
    ]
  },
  "mixins": [
    "dakimakuramod.mixins.json"
  ],
  "accessWidener": "dakimakuramod.accesswidener",
  "depends": {
    "fabricloader": ">=0.15.0",
    "minecraft": "~${minecraft_version}",
    "java": ">=17",
    "fabric-api": "*"
  }
}
